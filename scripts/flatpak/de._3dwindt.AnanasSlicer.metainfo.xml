<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
    <id>de._3dwindt.AnanasSlicer</id>
    <launchable type="desktop-id">de._3dwindt.AnanasSlicer.desktop</launchable>
    <name>ANANAS SLICER</name>
    <summary>Slicer for Klipper printers</summary>
    <developer id="io.github.Extrutex">
        <name>ANANAS SLICER contributors</name>
    </developer>
    <url type="homepage">https://github.com/Extrutex/KlipSlice</url>
    <url type="bugtracker">https://github.com/Extrutex/KlipSlice/issues</url>
    <url type="vcs-browser">https://github.com/Extrutex/KlipSlice</url>
    <metadata_license>0BSD</metadata_license>
    <project_license>AGPL-3.0-only</project_license>
    <content_rating type="oars-1.1" />
    <requires>
        <display_length compare="gt">768</display_length>
    </requires>
    <recommends>
        <control>keyboard</control>
        <control>pointing</control>
    </recommends>
    <screenshots>
        <screenshot type="default">
            <image>https://raw.githubusercontent.com/OrcaSlicer/OrcaSlicer/v2.3.2/scripts/flatpak/images/1.png</image>
            <caption>A model ready to be sliced on a buildplate.</caption>
        </screenshot>
        <screenshot>
            <image>https://raw.githubusercontent.com/OrcaSlicer/OrcaSlicer/v2.3.2/scripts/flatpak/images/2.png</image>
            <caption>A calibration test ready to be printed out.</caption>
        </screenshot>
    </screenshots>
    <description>
        <p>ANANAS SLICER is a free and open-source, community-developed FDM slicer for printers
            running Klipper, based on OrcaSlicer. It sends jobs to the printer through
            Moonraker.</p>
        <p>Key features include advanced calibration tools, adaptive layer heights, tree supports
            and multi-material support.</p>
    </description>
    <branding>
        <color type="primary" scheme_preference="light">#009688</color>
        <color type="primary" scheme_preference="dark">#00695C</color>
    </branding>
    <releases>
        <release version="2.5.0-dev" date="2026-06-22" type="development">
            <description>
                <p>Development build.</p>
            </description>
        </release>
    </releases>
</component>
